rules_version = '2';

// ─────────────────────────────────────────────
// Qatta (قطة) — Cloud Firestore Security Rules (Groups)
//
// users/{uid}                        → الملف الشخصي: لصاحبه فقط
// groups/{code}                      → المجموعة:
//    • الأعضاء: قراءة
//    • المنشئ: تعديل الاسم/الرمز + حذف المجموعة
//    • غير العضو (يملك الرمز): يضيف نفسه فقط (انضمام)
//    • العضو: يحدّث بياناته الظاهرة (memberInfo) فقط، أو يغادر
//    • المنشئ: يزيل أي عضو (تبقى مصاريفه وديونه)
// groups/{code}/expenses/{id}        → مصاريف المجموعة:
//    • الأعضاء: قراءة + إضافة + تسوية الحصص
//    • منشئ المصروف: تعديل كامل + حذف
//    • منشئ المجموعة: حذف أي مصروف
// groups/{code}/settlements/{id}     → تحويلات تقفيل الحساب: يضيفها الأعضاء
// ─────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ── User profiles ──
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ── Phone login index: بريد مشفّر بمفتاح من كلمة المرور (لا يكشف شيئاً بدونها) ──
    match /phoneIndex/{h} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
    }

    // ── Groups ──
    match /groups/{code} {

      function isMember() {
        return signedIn() && request.auth.uid in resource.data.members;
      }

      function isCreator() {
        return signedIn() && resource.data.createdBy == request.auth.uid;
      }

      function onlyChanged(keys) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
      }

      function onlyMyInfoChanged() {
        return request.resource.data.memberInfo.diff(resource.data.memberInfo).affectedKeys().hasOnly([request.auth.uid]);
      }

      // صاحب رقم الضيف (حساب جوال) يستطيع قراءة المجموعة ليرتبط بها تلقائياً
      function isGuestOwner() {
        return signedIn() && request.auth.token.email in resource.data.get('guestPhoneEmails', []);
      }

      allow read: if isMember() || isGuestOwner();

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.memberInfo.keys().hasOnly([request.auth.uid]);

      allow update: if
        // المنشئ: الاسم والرمز التعبيري والأعضاء (مع بقائه عضواً)
        (
          isCreator()
          && request.resource.data.createdBy == resource.data.createdBy
          && request.auth.uid in request.resource.data.members
          && request.resource.data.name is string && request.resource.data.name.size() > 0
        )
        // الضيوف: أي عضو يضيف/يعدّل/يحذف ضيفاً
        || (
          isMember()
          && onlyChanged(['guests', 'guestPhoneEmails', 'updatedAt'])
        )
        // الانضمام: غير العضو يضيف نفسه فقط
        || (
          signedIn()
          && !(request.auth.uid in resource.data.members)
          && onlyChanged(['members', 'memberInfo', 'updatedAt'])
          && request.resource.data.members.toSet() == resource.data.members.toSet().union([request.auth.uid].toSet())
          && onlyMyInfoChanged()
        )
        // العضو: يحدّث بياناته الظاهرة فقط
        || (
          isMember()
          && onlyChanged(['memberInfo', 'updatedAt'])
          && onlyMyInfoChanged()
        )
        // المغادرة: العضو (غير المنشئ) يزيل نفسه فقط — تبقى بياناته في المصاريف
        || (
          isMember() && !isCreator()
          && onlyChanged(['members', 'updatedAt'])
          && request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet())
        );

      allow delete: if isCreator();

      // ── Expenses ──
      match /expenses/{expenseId} {

        function group() {
          return get(/databases/$(database)/documents/groups/$(code)).data;
        }

        function inGroup() {
          return signedIn() && request.auth.uid in group().members;
        }

        function validExpense(d) {
          return d.title is string && d.title.size() > 0 && d.title.size() <= 120
            && d.totalAmount is number && d.totalAmount > 0 && d.totalAmount < 100000000
            && d.currency is string
            && d.category is string
            && d.splitMethod in ['equal', 'custom', 'percentage']
            && d.paidByUserId is string
            && d.participants is list && d.participants.size() >= 1 && d.participants.size() <= 50;
        }

        allow read: if inGroup();

        allow create: if inGroup()
          && request.resource.data.createdBy == request.auth.uid
          && validExpense(request.resource.data);

        allow update: if inGroup() && (
          (
            resource.data.createdBy == request.auth.uid
            && request.resource.data.createdBy == resource.data.createdBy
            && validExpense(request.resource.data)
          ) || (
            // التسوية ودمج الضيف في حساب عضو
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'participantIds', 'paidByUserId', 'updatedAt'])
            && request.resource.data.participants.size() >= 1
          )
        );

        allow delete: if signedIn() && (
          resource.data.createdBy == request.auth.uid
          || group().createdBy == request.auth.uid
        );
      }

      // ── Settlements (تقفيل الحساب): تحويل من شخص لآخر ──
      match /settlements/{settlementId} {

        function sGroup() {
          return get(/databases/$(database)/documents/groups/$(code)).data;
        }

        function sInGroup() {
          return signedIn() && request.auth.uid in sGroup().members;
        }

        allow read: if sInGroup();

        allow create: if sInGroup()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.from is string
          && request.resource.data.to is string
          && request.resource.data.from != request.resource.data.to
          && request.resource.data.amount is number
          && request.resource.data.amount > 0 && request.resource.data.amount < 100000000;

        // دمج الضيف: تحويل الطرفين من الضيف إلى العضو
        allow update: if sInGroup()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['from', 'to', 'fromName', 'toName'])
          && request.resource.data.from != request.resource.data.to;

        allow delete: if signedIn() && (
          resource.data.createdBy == request.auth.uid
          || sGroup().createdBy == request.auth.uid
          || sInGroup()
        );
      }
    }
  }
}
